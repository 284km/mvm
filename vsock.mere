import "virtio.mere";

// vsock.mere — virtio-vsock: streams between the guest and host sockets.
//
// WHY THIS DEVICE. The host and the guest have to talk, and the two obvious
// ways do not work here: virtio-net needs vmnet.framework, whose
// vmnet_start_interface returns 1001 for a process that is not root, and a
// shared file is not a stream. vsock is the transport whose whole reason for
// existing is host-to-guest, it needs no addresses, no DHCP and no bridge, and
// the guest kernel already has it -- as three modules rather than built in,
// which is a fact about the initramfs and not about the device.
//
// WHAT IT IS. Device id 19 on its own virtio-mmio window with its own SPI.
// Three queues -- rx, tx, event -- and a table of streams. A stream's guest
// end is a virtqueue and its host end is an ordinary AF_UNIX socket, so what
// is at the other end is a real program either way:
//
//   outward   the guest connects; the VMM connects to the path in MVM_VSOCK
//   inward    a host program connects to the path in MVM_VSOCK_IN; the VMM
//             starts the handshake toward a port the guest is listening on
//
// The inward direction is not the outward one with the arguments swapped: the
// VMM is the side that has to send REQUEST, on a queue the guest fills for it.
//
// WHAT IT REFUSES. SEQPACKET is not offered. More streams than the table holds
// are refused by name. Anything else is answered RST rather than ignored --
// each refusal is a packet the guest can see, not a case that falls through.

extern fn hv_read_u32: str -> int;
extern fn hv_write_u32: str -> int -> int;
extern fn hv_write_u16: str -> int -> int;
extern fn hv_write_u64: str -> str -> int;
extern fn hv_spi: int -> int -> int;
extern fn hv_vs_connect: str -> int;
extern fn hv_vs_listen: str -> int -> int;
extern fn hv_vs_accepted_port: unit -> int;
extern fn hv_vs_accept: unit -> int;
extern fn hv_vs_close: int -> int;
extern fn hv_vs_send: int -> str -> int -> int;
extern fn hv_vs_recv: int -> str -> int -> int;
extern fn hv_vs_ready: int -> int;
extern fn hv_vs_mute: int -> int;
extern fn hv_vs_wake: unit -> int;
extern fn hv_vs_unlisten: int -> int;
extern fn hv_vs_listener_count: unit -> int;
extern fn hv_ctl_listen: str -> int;
extern fn hv_ctl_accept: unit -> int;
extern fn hv_ctl_line: int -> str;
extern fn hv_ctl_reply: int -> str -> int;
extern fn hv_ctl_close: int -> int;

let vs_base = 0xa000200;
let vs_intid = 49;                  // SPI 17 in the device tree, which is 32+17
let vs_qmax = 64;
let vs_cid_host = 2;                // fixed by the specification
let vs_cid_guest = 3;               // the first cid a guest is allowed
let vs_hdr = 44;                    // the packet header, by the specification's layout
let vs_buf_alloc = 262144;          // what this end claims it can hold

let vs_type_stream = 1;
let op_request = 1; let op_response = 2; let op_rst = 3; let op_shutdown = 4;
let op_rw = 5; let op_credit_update = 6; let op_credit_request = 7;

// ---- state ----------------------------------------------------------------
//
// Five device-wide slots, then six per queue -- three queues means three
// descriptor tables, and a field that holds one address cannot answer for
// three -- then a table of streams.

let vs_dfsel = 0; let vs_drvfsel = 1; let vs_qsel = 2; let vs_status = 3; let vs_isr = 4;
let vs_qfirst = 5; let vs_qstride = 6;
let vs_isr_reads = 23;   // how many times the guest has read this device's ISR
let vs_polls = 24;       // how many times the host end has been asked
let vs_next_hport = 25;  // this end's port for the next inward stream
let vs_in_port = 26;     // non-zero once anything is listening inward
let vs_sfirst = 27; let vs_sstride = 8; let vs_smax = 32;
let vs_state_n = 27 + 32 * 8;

// A stream's fields, and its state: free, waiting for the guest to answer a
// REQUEST this end sent, or open.
let s_handle = 0; let s_gport = 1; let s_hport = 2; let s_fwd = 3;
let s_sent = 4; let s_alloc = 5; let s_pfwd = 6; let s_st = 7;
let st_free = 0; let st_waiting = 1; let st_open = 2;

let sf = fn (i: int) -> fn (f: int) -> vs_sfirst + i * vs_sstride + f;
let sget = fn (s) -> fn (i: int) -> fn (f: int) -> (vec_get s (sf i f) : int);
let sset = fn (s) -> fn (i: int) -> fn (f: int) -> fn (v: int) -> vec_set s (sf i f) v;

let vs_new = fn (u: unit) ->
  let v = vec_new () in
  let rec fill = fn (i: int) ->
    if i == vs_state_n then () else let _ = vec_push v 0 in fill (i + 1) in
  let _ = fill 0 in
  let rec clear = fn (i: int) ->
    if i == vs_smax then ()
    else
      let _ = vec_set v (vs_sfirst + i * vs_sstride + s_handle) (0 - 1) in
      let _ = vec_set v (vs_sfirst + i * vs_sstride + s_st) st_free in
      clear (i + 1) in
  let _ = clear 0 in
  let _ = vec_set v vs_next_hport 49152 in
  let _ = vec_set v vs_in_port 1024 in
  // The thread that wakes the vCPU is part of the device, not part of one
  // direction. Starting it when an outward stream opens left it unstarted for
  // a VMM that only listens, and moving it to the listening path left it
  // unstarted for one that only connects out -- the same bug twice, once in
  // each direction, because it was attached to an event rather than to the
  // device coming up.
  let _ = hv_vs_wake () in
  v;

let q_num = 0; let q_ready = 1; let q_desc = 2; let q_avail = 3; let q_used = 4; let q_last = 5;
let qf = fn (q: int) -> fn (f: int) -> vs_qfirst + q * vs_qstride + f;
let qget = fn (s) -> fn (q: int) -> fn (f: int) -> (vec_get s (qf q f) : int);
let qset = fn (s) -> fn (q: int) -> fn (f: int) -> fn (v: int) -> vec_set s (qf q f) v;
let q_rx = 0; let q_tx = 1; let q_ev = 2;

let vs_tracing = fn (u: unit) ->
  match env_var "MVM_VSOCK_TRACE" with
  | Some v -> str_len v > 0
  | _ -> false;

// A stream is named by the pair of ports, not by either alone: the guest may
// have several streams to the same port of ours and several of ours to the
// same port of its.
let vs_find = fn (s) -> fn (gport: int) -> fn (hport: int) ->
  let rec go = fn (i: int) ->
    if i == vs_smax then 0 - 1
    else if sget s i s_st != st_free && sget s i s_gport == gport && sget s i s_hport == hport
    then i else go (i + 1) in
  go 0;

let vs_alloc = fn (s) ->
  let rec go = fn (i: int) ->
    if i == vs_smax then 0 - 1
    else if sget s i s_st == st_free then i else go (i + 1) in
  go 0;

let vs_release = fn (s) -> fn (i: int) ->
  let h = sget s i s_handle in
  let _ = if vs_tracing () then
            print_err ("mvm: vsock released host port " ++ show (sget s i s_hport)
                    ++ " (guest took " ++ show (sget s i s_fwd) ++ " bytes, was given "
                    ++ show (sget s i s_sent) ++ ")") else () in
  let _ = if h >= 0 then (let _ = hv_vs_close h in ()) else () in
  let _ = sset s i s_handle (0 - 1) in
  let _ = sset s i s_st st_free in
  let _ = sset s i s_fwd 0 in
  let _ = sset s i s_sent 0 in
  0;

// ---- packets --------------------------------------------------------------

// The two cids are 64-bit, which is why they go through one call rather than
// two halves: an identifier split across two writes is two chances to write
// one of them and not the other.
let vs_put_hdr = fn (a: int) -> fn (src_port: int) -> fn (dst_port: int)
              -> fn (len: int) -> fn (op: int) -> fn (flags: int) -> fn (fwd: int) ->
  let _ = hv_write_u64 (hexs a) (hexs vs_cid_host) in
  let _ = hv_write_u64 (hexs (a + 8)) (hexs vs_cid_guest) in
  let _ = hv_write_u32 (hexs (a + 16)) src_port in
  let _ = hv_write_u32 (hexs (a + 20)) dst_port in
  let _ = hv_write_u32 (hexs (a + 24)) len in
  let _ = hv_write_u16 (hexs (a + 28)) vs_type_stream in
  let _ = hv_write_u16 (hexs (a + 30)) op in
  let _ = hv_write_u32 (hexs (a + 32)) flags in
  let _ = hv_write_u32 (hexs (a + 36)) vs_buf_alloc in
  let _ = hv_write_u32 (hexs (a + 40)) fwd in
  0;

// One buffer off the rx available ring, or -1 when the guest has posted none.
// Not taking one is the normal case and not an error: it means the guest is
// not ready to be told anything yet, and the packet has to wait.
let vs_rx_take = fn (s) ->
  let qn = qget s q_rx q_num in
  let av = qget s q_rx q_avail in
  if qn == 0 then 0 - 1
  else
    let aidx = hv_read_u16 (hexs (av + 2)) in
    let last = qget s q_rx q_last in
    if last == aidx then 0 - 1
    else hv_read_u16 (hexs (av + 4 + (last % qn) * 2));

let vs_rx_done = fn (s) -> fn (head: int) -> fn (len: int) ->
  let qn = qget s q_rx q_num in
  let us = qget s q_rx q_used in
  let uidx = hv_read_u16 (hexs (us + 2)) in
  let _ = hv_write_u32 (hexs (us + 4 + (uidx % qn) * 8)) head in
  let _ = hv_write_u32 (hexs (us + 4 + (uidx % qn) * 8 + 4)) len in
  let _ = hv_write_u16 (hexs (us + 2)) (bit_and (uidx + 1) 65535) in
  let _ = qset s q_rx q_last (bit_and (qget s q_rx q_last + 1) 65535) in
  let _ = vec_set s vs_isr 1 in
  let _ = hv_spi vs_intid 1 in
  0;

// A packet with no payload, addressed by ports rather than by a stream:
// a refusal has to be sendable for a stream this end declined to create.
let vs_ctl_ports = fn (s) -> fn (src_port: int) -> fn (dst_port: int)
                -> fn (op: int) -> fn (flags: int) -> fn (fwd: int) ->
  let head = vs_rx_take s in
  if head < 0 then
    // Named, not swallowed. "The guest posted no receive buffer" and "the
    // packet was sent and lost" look identical from the guest -- it waits --
    // and only this end can tell them apart.
    let _ = print_err ("mvm: vsock could not send op " ++ show op
                    ++ ": no rx buffer (qnum " ++ show (qget s q_rx q_num)
                    ++ " ready " ++ show (qget s q_rx q_ready) ++ ")") in
    0 - 1
  else
    let tbl = qget s q_rx q_desc in
    let a = d_addr tbl head in
    let l = d_len tbl head in
    if l < vs_hdr then
      let _ = print_err ("mvm: vsock rx buffer is " ++ show l ++ " bytes, shorter than a header") in 0 - 1
    else
      let _ = vs_put_hdr a src_port dst_port 0 op flags fwd in
      let _ = if vs_tracing () then
                print_err ("mvm: vsock sent op " ++ show op ++ " port " ++ show src_port
                        ++ " to " ++ show dst_port) else () in
      let _ = vs_rx_done s head vs_hdr in
      0;

// The same, for a stream that exists.
let vs_ctl = fn (s) -> fn (i: int) -> fn (op: int) -> fn (flags: int) ->
  vs_ctl_ports s (sget s i s_hport) (sget s i s_gport) op flags (sget s i s_fwd);

// Whatever the host end of one stream has said, up to one buffer's worth and
// up to the credit the guest has advertised.
let vs_pump_one = fn (s) -> fn (i: int) ->
  let h = sget s i s_handle in
  let _ = vec_set s vs_polls ((vec_get s vs_polls : int) + 1) in
  if h < 0 || sget s i s_st != st_open then 0
  else if hv_vs_ready h == 0 then 0
  else
    let head = vs_rx_take s in
    if head < 0 then 0
    else
      let tbl = qget s q_rx q_desc in
      let a = d_addr tbl head in
      let l = d_len tbl head in
      if l <= vs_hdr then 0
      else
        // What the guest has room for: what it said it can hold, less what it
        // has been sent and not yet taken. Ignoring this is how a device
        // overruns a driver that was telling it not to.
        let room = sget s i s_alloc - (sget s i s_sent - sget s i s_pfwd) in
        let cap = if l - vs_hdr < room then l - vs_hdr else room in
        if cap <= 0 then 0
        else
          let n = hv_vs_recv h (hexs (a + vs_hdr)) cap in
          if n > 0 then
            let _ = vs_put_hdr a (sget s i s_hport) (sget s i s_gport)
                                 n op_rw 0 (sget s i s_fwd) in
            let _ = sset s i s_sent (sget s i s_sent + n) in
            let _ = if vs_tracing () then
                      print_err ("mvm: vsock host->guest " ++ show n ++ " bytes on host port "
                              ++ show (sget s i s_hport)) else () in
            let _ = vs_rx_done s head (vs_hdr + n) in
            n
          else if n == 0 - 2 then
            // End of file on the host end means "the peer will send no more".
            // It does NOT mean the stream is over: a client that closes its
            // write side is still waiting to read the answer, and `docker run`
            // does exactly that on the connection it attaches with.
            //
            // So SHUTDOWN carries F_SEND alone (2), not both directions (3).
            // Sending 3 tells the guest this end will not RECEIVE either,
            // which shuts down the guest's write side -- and the answer it was
            // about to write is then never sent. The witness was an attach
            // stream that carried its 101 header and nothing after it, while
            // the daemon's own log said it had framed 26 bytes of output.
            //
            // The socket stays open, muted rather than closed, because closing
            // it would take the write direction with it.
            let _ = vs_put_hdr a (sget s i s_hport) (sget s i s_gport)
                                 0 op_shutdown 2 (sget s i s_fwd) in
            let _ = vs_rx_done s head vs_hdr in
            let _ = hv_vs_mute h in
            0 - 2
          else 0;

// A host program waiting to be let in. The VMM starts the handshake, which is
// what makes this the other direction rather than the same one reversed.
let vs_accept = fn (s) ->
  if (vec_get s vs_in_port : int) == 0 then 0
  else
    let h = hv_vs_accept () in
    if h == 0 - 2 then
      let _ = print_err ("mvm: vsock refused an inward connection: all "
                      ++ show vs_smax ++ " streams are in use") in 0
    else if h < 0 then 0
    else
      let i = vs_alloc s in
      if i < 0 then
        let _ = print_err "mvm: vsock refused an inward connection: no free stream" in
        let _ = hv_vs_close h in 0
      else
        let hp = (vec_get s vs_next_hport : int) in
        // WHICH mapping it arrived on decides who in the guest answers. One
        // field holding "the" inward port cannot answer for several.
        let gp = hv_vs_accepted_port () in
        let _ = vec_set s vs_next_hport (hp + 1) in
        let _ = sset s i s_handle h in
        let _ = sset s i s_gport gp in
        let _ = sset s i s_hport hp in
        let _ = sset s i s_fwd 0 in
        let _ = sset s i s_sent 0 in
        let _ = sset s i s_alloc vs_buf_alloc in
        let _ = sset s i s_pfwd 0 in
        let _ = sset s i s_st st_waiting in
        let _ = print_err ("mvm: vsock inward stream, host port " ++ show hp
                        ++ " to guest port " ++ show gp) in
        if vs_ctl s i op_request 0 < 0 then
          // The guest is not ready to be told anything -- its driver may not
          // be up yet, which is the normal case for a host that connects
          // early. Keeping the stream would hold a slot and an open host
          // socket for a handshake that was never started; there are eight
          // slots, so eight early connections would leave no room for the
          // ninth, which is the one that would have worked. Let it go and let
          // the host try again.
          let _ = vs_release s i in
          let _ = print_err "mvm: vsock dropped that inward stream; the guest was not ready" in 0
        else 1;

// ---- the control socket ---------------------------------------------------
//
// A published port's host end has to be opened by the host, and nothing knows
// which port until a container asks for one. So there is a socket to ask on.
// Three verbs, one line each, and every answer names what happened:
//
//   LISTEN <port>    -> ok listening <port>   / err <reason>
//   UNLISTEN <port>  -> ok closed <port>      / err no listener for <port>
//   PORTS            -> ok <n> listeners
//
// It is the VMM's own socket, not the guest's, and it says nothing about
// containers: it opens and closes host ports, and who wanted one is the
// caller's business.

let vs_word = fn (line: str) -> fn (n: int) ->
  let rec go = fn (i: int) -> fn (start: int) -> fn (seen: int) ->
    if i >= str_len line then (if seen == n then substring line start (str_len line) else "")
    else if char_at line i == " " then
      (if seen == n then substring line start i else go (i + 1) (i + 1) (seen + 1))
    else go (i + 1) start seen in
  go 0 0 0;

// A number from a word, or 0 for anything else. int_of_str aborts on input
// that is not a number, and this word came off a socket -- a caller that types
// nonsense must get an answer, not take the machine down.
let vs_num = fn (t: str) ->
  let n = str_len t in
  if n == 0 then 0
  else
    let rec go = fn (i: int) -> fn (acc: int) ->
      if i == n then acc
      else
        let c = ord (char_at t i) in
        if c < 48 || c > 57 then 0 - 1
        else go (i + 1) (acc * 10 + (c - 48)) in
    let v = go 0 0 in
    if v < 0 then 0 else v;

let vs_ctl_do = fn (s) -> fn (line: str) ->
  let verb = vs_word line 0 in
  let arg = vs_word line 1 in
  let port = vs_num arg in
  if verb == "PORTS" then "ok " ++ show (hv_vs_listener_count ()) ++ " listeners"
  else if verb == "LISTEN" then
    (if port <= 0 || port > 65535 then "err " ++ arg ++ " is not a port"
     else
       let r = hv_vs_listen ("tcp:" ++ show port) port in
       if r == 0 then
         let _ = print_err ("mvm: listening on host port " ++ show port
                         ++ " for guest vsock " ++ show port) in
         "ok listening " ++ show port
       else if r == 0 - 2 then "err no room for another listener"
       else "err cannot listen on " ++ show port)
  else if verb == "UNLISTEN" then
    (if hv_vs_unlisten port == 0 then
       let _ = print_err ("mvm: closed host port " ++ show port) in
       "ok closed " ++ show port
     else "err no listener for " ++ show port)
  else if str_len verb == 0 then "err empty"
  else "err unknown verb " ++ verb;

// One caller, one command, one answer. Called wherever the host end is
// polled, so it costs nothing while nobody is asking.
let vs_control = fn (s) ->
  let c = hv_ctl_accept () in
  if c < 0 then 0
  else
    let line = hv_ctl_line c in
    let _ = if str_len line == 0 then 0 else hv_ctl_reply c (vs_ctl_do s line) in
    let _ = hv_ctl_close c in
    1;

// Drain, not one buffer per wake, and every stream rather than one. A reply
// larger than one receive buffer is the normal case, and handing over one
// buffer per wake-up makes the stream's speed a property of how often a thread
// happens to poll.
let vs_pump = fn (s) ->
  let _ = vs_control s in
  let _ = vs_accept s in
  let rec sweep = fn (i: int) -> fn (moved: int) ->
    if i == vs_smax then moved
    else
      let rec drain = fn (total: int) -> fn (guard: int) ->
        if guard == 0 then total
        else
          let n = vs_pump_one s i in
          if n > 0 then drain (total + n) (guard - 1) else total in
      sweep (i + 1) (moved + drain 0 4096) in
  sweep 0 0;

// ---- the guest's side of a stream -----------------------------------------

let vs_tx_one = fn (s) -> fn (path: str) -> fn (head: int) ->
  let tbl = qget s q_tx q_desc in
  let a0 = d_addr tbl head in
  let l0 = d_len tbl head in
  if l0 < vs_hdr then
    let _ = print_err ("mvm: vsock tx descriptor is " ++ show l0 ++ " bytes, shorter than a header") in 0
  else
    let src_port = hv_read_u32 (hexs (a0 + 16)) in
    let dst_port = hv_read_u32 (hexs (a0 + 20)) in
    let plen = hv_read_u32 (hexs (a0 + 24)) in
    let op = hv_read_u16 (hexs (a0 + 30)) in
    let alloc = hv_read_u32 (hexs (a0 + 36)) in
    let pfwd = hv_read_u32 (hexs (a0 + 40)) in
    // The payload is the rest of this descriptor, or the next one in the
    // chain. Linux sends the header and the data as separate entries; a
    // driver that inlines them is also legal, so both are read.
    let has_next = bit_and (d_flags tbl head) vring_desc_f_next != 0 in
    let pa = if l0 > vs_hdr then a0 + vs_hdr
             else if has_next then d_addr tbl (d_next tbl head)
             else 0 in
    let i = vs_find s src_port dst_port in
    let _ = if i >= 0 then
              (let _ = sset s i s_alloc alloc in let _ = sset s i s_pfwd pfwd in ())
            else () in
    if op == op_request then
      // Outward: the guest is asking for a stream to a host path.
      (if i >= 0 then let _ = vs_ctl s i op_rst 0 in 0
       else if str_len path == 0 then
         let _ = print_err ("mvm: vsock port " ++ show dst_port
                         ++ ": this VMM was given no outward path") in
         let _ = vs_ctl_ports s dst_port src_port op_rst 0 0 in 0
       else
         let j = vs_alloc s in
         if j < 0 then
           let _ = print_err ("mvm: vsock refused an outward stream: all "
                           ++ show vs_smax ++ " streams are in use") in
           let _ = vs_ctl_ports s dst_port src_port op_rst 0 0 in 0
         else
           let h = hv_vs_connect path in
           if h < 0 then
             let _ = print_err ("mvm: vsock port " ++ show dst_port
                             ++ ": nothing listening at " ++ path) in
             let _ = vs_ctl_ports s dst_port src_port op_rst 0 0 in 0
           else
             let _ = sset s j s_handle h in
             let _ = sset s j s_gport src_port in
             let _ = sset s j s_hport dst_port in
             let _ = sset s j s_fwd 0 in
             let _ = sset s j s_sent 0 in
             let _ = sset s j s_alloc alloc in
             let _ = sset s j s_pfwd pfwd in
             let _ = sset s j s_st st_open in
             let _ = print_err ("mvm: vsock outward stream, guest port "
                             ++ show (bit_and src_port 0xffffffff)
                             ++ " to port " ++ show dst_port) in
             let _ = vs_ctl s j op_response 0 in 0)
    else if i < 0 then
      // A packet for a stream this end does not have. Answered rather than
      // dropped: a guest waiting on a stream nobody owns waits forever.
      (if op == op_rst then 0 else let _ = vs_ctl_ports s dst_port src_port op_rst 0 0 in 0)
    else if op == op_response then
      // Inward: the guest accepted the connection this end asked for.
      (let _ = sset s i s_st st_open in
       let _ = print_err ("mvm: vsock inward stream accepted by the guest on port "
                       ++ show dst_port) in 0)
    else if op == op_rw then
      (if sget s i s_st != st_open then let _ = vs_ctl s i op_rst 0 in 0
       else if pa == 0 then 0
       else
         let n = hv_vs_send (sget s i s_handle) (hexs pa) plen in
         let _ = if vs_tracing () then
                   print_err ("mvm: vsock guest->host " ++ show plen ++ " bytes on host port "
                           ++ show (sget s i s_hport) ++ " -> " ++ show n) else () in
         if n < 0 then
           let _ = print_err "mvm: vsock host write failed" in
           let _ = vs_ctl s i op_rst 0 in
           let _ = vs_release s i in 0
         else
           // Credit back. The guest stops sending when it thinks this end is
           // full, so the count of what has been taken has to keep moving.
           let _ = sset s i s_fwd (sget s i s_fwd + n) in
           let _ = vs_ctl s i op_credit_update 0 in 0)
    else if op == op_credit_request then let _ = vs_ctl s i op_credit_update 0 in 0
    else if op == op_credit_update then 0
    else if op == op_shutdown then
      (let _ = vs_ctl s i op_rst 0 in let _ = vs_release s i in 0)
    else if op == op_rst then
      (let _ = vs_release s i in 0)
    else
      let _ = print_err ("mvm: vsock refused op " ++ show op) in
      let _ = vs_ctl s i op_rst 0 in 0;

// A queue the guest has notified. tx is where the work is; rx and event are
// buffers being posted, and posting is not something to consume.
let vs_notify = fn (s) -> fn (path: str) -> fn (q: int) ->
  if q != q_tx then let _ = vs_pump s in 0
  else
    let qn = qget s q_tx q_num in
    let av = qget s q_tx q_avail in
    let us = qget s q_tx q_used in
    if qn == 0 then 0
    else
      let aidx = hv_read_u16 (hexs (av + 2)) in
      let rec go = fn (last: int) -> fn (n: int) ->
        if last == aidx then n
        else
          let head = hv_read_u16 (hexs (av + 4 + (last % qn) * 2)) in
          let _ = vs_tx_one s path head in
          let uidx = hv_read_u16 (hexs (us + 2)) in
          let _ = hv_write_u32 (hexs (us + 4 + (uidx % qn) * 8)) head in
          let _ = hv_write_u32 (hexs (us + 4 + (uidx % qn) * 8 + 4)) 0 in
          let _ = hv_write_u16 (hexs (us + 2)) (bit_and (uidx + 1) 65535) in
          go (bit_and (last + 1) 65535) (n + 1) in
      let done = go (qget s q_tx q_last) 0 in
      let _ = qset s q_tx q_last aidx in
      let _ = if done > 0 then
                (let _ = vec_set s vs_isr 1 in let _ = hv_spi vs_intid 1 in ())
              else () in
      // The guest sent something, so the host may already have answered.
      let _ = vs_pump s in
      done;

let vs_polls_of = fn (s) -> (vec_get s vs_polls : int);

// Start listening for inward connections. Separate from vs_new because it can
// fail, and a VMM that cannot open the socket it was asked for should say so
// rather than run as if it had.
let vs_listen = fn (s) -> fn (path: str) -> fn (gport: int) ->
  if str_len path == 0 then 0
  else
    let r = hv_vs_listen path gport in
    if r != 0 then
      let _ = print_err ("mvm: vsock could not listen at " ++ path) in 0 - 1
    else
      let _ = vec_set s vs_in_port 1 in
      let _ = print_err ("mvm: vsock listening at " ++ path
                      ++ " for guest port " ++ show gport) in
      0;

// ---- the transport registers ----------------------------------------------

let vs_read = fn (s) -> fn (off: int) ->
  if off == 0x000 then 0x74726976                 // "virt"
  else if off == 0x004 then 2                     // version 2
  else if off == 0x008 then 19                    // vsock
  else if off == 0x00c then 0x4d455245             // "MERE"
  else if off == 0x010 then
    // VIRTIO_F_VERSION_1 and nothing else. Not offering SEQPACKET is what
    // keeps a second framing out of a device that implements one.
    (if (vec_get s vs_dfsel : int) == 1 then 1 else 0)
  else if off == 0x034 then vs_qmax
  else if off == 0x044 then qget s (vec_get s vs_qsel : int) q_ready
  else if off == 0x060 then
    let _ = vec_set s vs_isr_reads ((vec_get s vs_isr_reads : int) + 1) in
    (vec_get s vs_isr : int)
  else if off == 0x070 then (vec_get s vs_status : int)
  else if off == 0x0fc then 0
  else if off == 0x100 then vs_cid_guest          // guest_cid, low word
  else if off == 0x104 then 0                     // and high
  else 0;

let vs_write = fn (s) -> fn (path: str) -> fn (off: int) -> fn (v: int) ->
  let q = (vec_get s vs_qsel : int) in
  let inq = q >= 0 && q < 3 in
  if off == 0x014 then let _ = vec_set s vs_dfsel v in 0
  else if off == 0x024 then let _ = vec_set s vs_drvfsel v in 0
  else if off == 0x030 then
    (if v >= 0 && v < 3 then let _ = vec_set s vs_qsel v in 0
     else let _ = print_err ("mvm: vsock refused queue " ++ show v) in 0)
  else if off == 0x038 then (if inq then let _ = qset s q q_num v in 0 else 0)
  else if off == 0x044 then (if inq then let _ = qset s q q_ready v in 0 else 0)
  else if off == 0x050 then vs_notify s path v
  else if off == 0x064 then
    let _ = vec_set s vs_isr (bit_and (vec_get s vs_isr : int) (bit_not v)) in
    let _ = if (vec_get s vs_isr : int) == 0 then hv_spi vs_intid 0 else 0 in
    0
  else if off == 0x070 then let _ = vec_set s vs_status v in 0
  else if off == 0x080 then (if inq then let _ = qset s q q_desc (bit_or (bit_and (qget s q q_desc) (bit_shl 0xffffffff 32)) v) in 0 else 0)
  else if off == 0x084 then (if inq then let _ = qset s q q_desc (bit_or (bit_and (qget s q q_desc) 0xffffffff) (bit_shl v 32)) in 0 else 0)
  else if off == 0x090 then (if inq then let _ = qset s q q_avail (bit_or (bit_and (qget s q q_avail) (bit_shl 0xffffffff 32)) v) in 0 else 0)
  else if off == 0x094 then (if inq then let _ = qset s q q_avail (bit_or (bit_and (qget s q q_avail) 0xffffffff) (bit_shl v 32)) in 0 else 0)
  else if off == 0x0a0 then (if inq then let _ = qset s q q_used (bit_or (bit_and (qget s q q_used) (bit_shl 0xffffffff 32)) v) in 0 else 0)
  else if off == 0x0a4 then (if inq then let _ = qset s q q_used (bit_or (bit_and (qget s q q_used) 0xffffffff) (bit_shl v 32)) in 0 else 0)
  else 0;
