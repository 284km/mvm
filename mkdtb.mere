// mkdtb.mere — write the device tree this VMM hands its guest.
//
//   mkdtb <out.dtb>
//
// Separate from the VMM so `dtc -I dtb -O dts` can read it back without
// starting a virtual machine. The addresses here are the ones the emulator
// answers at; they are constants in one file for that reason.

import "fdt.mere";

// The GIC's window sizes come from the framework that implements it, not from
// this file. Writing 0x100000 here because it looked like enough produced a
// data abort in the middle of GICv3 initialisation, at an address inside the
// window the tree claimed and outside the one the framework answers for.
extern fn hv_up: unit -> int;
extern fn hv_gic_dist_size: unit -> int;
extern fn hv_gic_redist_size: unit -> int;
extern fn hv_gic_redist_region_size: unit -> int;
extern fn hv_now_secs: unit -> int;

let ram_base    = 0x40000000;
// The SAME number boot.mere maps, from the same place, because two files that
// have to agree are two files that can disagree -- which is what happened:
// this said 1024 while the VMM mapped 4096, and the guest believed this one.
// The guest's own "Memory: ... available" line is what the gate compares
// against, since only the guest can say which of the two it was told.
let ram_size_mb = fn (u: unit) ->
  match env_var "MVM_RAM_MB" with
  | Some v -> (let n = int_of_str v in if n > 0 then n else 4096)
  | _ -> 4096;
let uart_base   = 0x9000000;
let gic_dist    = 0x8000000;
let gic_redist  = 0x80a0000;

let phandle_gic = 1;
let phandle_clk = 2;

// The initrd's bounds go in /chosen. The kernel reads them as a number of
// whatever width the property is, so two cells is a 64-bit address and one is
// a 32-bit one; two is written here because the rest of this tree is 64-bit
// and a tree that mixes them for no reason is a tree someone will misread.
let rtc_base = 0x9010000;

let build = fn (bootargs: str) -> fn (dist_size: int) -> fn (redist_size: int) ->
            fn (initrd_start: int) -> fn (initrd_end: int) -> fn (ncpu: int) ->
  let st = bytebuf_new 0 in
  let strs = bytebuf_new 0 in
  let bn = begin_node st in
  let en = fn (u: unit) -> end_node st in
  let ps = prop_str st strs in
  let pu = prop_u32 st strs in
  let pc = prop_cells st strs in
  let pe = prop_empty st strs in
  let p2 = prop_strs2 st strs in

  let _ = bn "" in
    let _ = pu "#address-cells" 2 in
    let _ = pu "#size-cells" 2 in
    let _ = ps "compatible" "linux,dummy-virt" in
    let _ = pu "interrupt-parent" phandle_gic in

    let _ = bn "chosen" in
      let _ = ps "bootargs" bootargs in
      let _ = ps "stdout-path" "/pl011@9000000" in
      let _ = if initrd_end > initrd_start then
                (let _ = pc "linux,initrd-start" [0, initrd_start] in
                 let _ = pc "linux,initrd-end" [0, initrd_end] in ())
              else () in
    let _ = en () in

    // reg is <hi lo hi lo> because #address-cells and #size-cells are 2.
    let _ = bn "memory@40000000" in
      let _ = ps "device_type" "memory" in
      // Two cells, high then low. 4 GiB is 0x1_0000_0000, which does not fit
      // in the low one: written as a single 32-bit value it truncates to ZERO
      // and the guest is told it has no memory at all. The kernel's answer to
      // that is "Failed to allocate page table page" in paging_init, which
      // names neither the tree nor the size.
      let ram_sz = ram_size_mb () * 1048576 in
      let _ = pc "reg" [0, ram_base, ram_sz / 4294967296, bit_and ram_sz 0xffffffff] in
    let _ = en () in

    // ONE NODE PER CPU, written as a loop rather than as a first one and the
    // others: a tree with two literal nodes is a tree that has to be edited
    // again for four. `reg` is the MPIDR's affinity level 0, which is the
    // number the guest uses to name a CPU in PSCI CPU_ON.
    let _ = bn "cpus" in
      let _ = pu "#address-cells" 1 in
      let _ = pu "#size-cells" 0 in
      let rec cpu = fn (i: int) ->
        if i == ncpu then ()
        else
          let _ = bn ("cpu@" ++ show i) in
            let _ = ps "device_type" "cpu" in
            let _ = ps "compatible" "arm,armv8" in
            let _ = pu "reg" i in
            // Every CPU including the first: the boot CPU is started by the
            // VMM and the rest by PSCI, and the kernel reads this to know how.
            let _ = ps "enable-method" "psci" in
          let _ = en () in
          cpu (i + 1) in
      let _ = cpu 0 in
    let _ = en () in

    // The kernel calls PSCI through HVC, which lands in this VMM as an exit.
    let _ = bn "psci" in
      let _ = ps "compatible" "arm,psci-1.0" in
      let _ = ps "method" "hvc" in
    let _ = en () in

    // The four generic-timer PPIs. 0x108 is level-triggered on all CPUs.
    let _ = bn "timer" in
      let _ = ps "compatible" "arm,armv8-timer" in
      let _ = pc "interrupts" [1, 13, 0x108, 1, 14, 0x108, 1, 11, 0x108, 1, 10, 0x108] in
      let _ = pe "always-on" in
    let _ = en () in

    let _ = bn "intc@8000000" in
      let _ = ps "compatible" "arm,gic-v3" in
      let _ = pu "#interrupt-cells" 3 in
      let _ = pu "#address-cells" 2 in
      let _ = pu "#size-cells" 2 in
      let _ = pe "interrupt-controller" in
      let _ = pe "ranges" in
      let _ = pc "reg" [0, gic_dist, 0, dist_size, 0, gic_redist, 0, redist_size] in
      let _ = pu "phandle" phandle_gic in
    let _ = en () in

    // A real-time clock. Without one the guest starts at the epoch, and every
    // timestamp it hands out -- a container's Created, a log line's date -- is
    // 1970. That is not cosmetic: the clients that read those fields parse
    // them, and "56 years ago" is what a working daemon looks like when it has
    // no idea what time it is.
    let _ = bn "pl031@9010000" in
      let _ = p2 "compatible" "arm,pl031" "arm,primecell" in
      let _ = pc "reg" [0, rtc_base, 0, 0x1000] in
      let _ = pc "interrupts" [0, 2, 4] in
      let _ = pc "clocks" [phandle_clk] in
      let _ = ps "clock-names" "apb_pclk" in
    let _ = en () in
    let _ = bn "pl011@9000000" in
      let _ = p2 "compatible" "arm,pl011" "arm,primecell" in
      let _ = pc "reg" [0, uart_base, 0, 0x1000] in
      let _ = pc "interrupts" [0, 1, 4] in
      let _ = pc "clocks" [phandle_clk, phandle_clk] in
      let _ = p2 "clock-names" "uartclk" "apb_pclk" in
    let _ = en () in

    // The transport the block device sits behind. The base and the interrupt
    // are the ones boot.mere answers at; one file decides both.
    let _ = bn "virtio_mmio@a000000" in
      let _ = ps "compatible" "virtio,mmio" in
      let _ = pc "reg" [0, 0xa000000, 0, 0x200] in
      // SPI 16 is intid 48; 4 is level-high, which is what this device raises.
      let _ = pc "interrupts" [0, 16, 4] in
    let _ = en () in

    // The second transport. vsock's queues are the same shape as the block
    // device's, but what is behind them is not, so it gets its own window and
    // its own interrupt rather than sharing either.
    let _ = bn "virtio_mmio@a000200" in
      let _ = ps "compatible" "virtio,mmio" in
      let _ = pc "reg" [0, 0xa000200, 0, 0x200] in
      let _ = pc "interrupts" [0, 17, 4] in
    let _ = en () in

    let _ = bn "apb-pclk" in
      let _ = ps "compatible" "fixed-clock" in
      let _ = pu "#clock-cells" 0 in
      let _ = pu "clock-frequency" 24000000 in
      let _ = ps "clock-output-names" "clk24mhz" in
      let _ = pu "phandle" phandle_clk in
    let _ = en () in
  let _ = en () in
  fdt_finish st strs;

// The command line the kernel is handed. Fixed by default, because two files
// that have to agree are two files that can disagree -- but a root filesystem
// on a disk needs `root=`, and that is the caller's fact rather than this
// program's, so there is one way to say it.
let bootargs_or = fn (dflt: str) ->
  let base = match env_var "MVM_BOOTARGS" with
             | Some v -> if str_len v > 0 then v else dflt
             | _ -> dflt in
  // What time it is, told to the guest directly.
  //
  // There is a PL031 in the tree, which is the proper way -- but its driver is
  // a module in a stock kernel and one that is not always installed, and a
  // guest whose clock reads 1970 hands out timestamps that its clients parse.
  // An unrecognised key=value on the command line reaches init as an
  // environment variable, so this works whatever modules exist. Both numbers
  // come from the same call on this machine, so they cannot disagree.
  base ++ " MVM_EPOCH=" ++ show (hv_now_secs ());

// HOW MANY, and the same answer the VMM will give: one name, read in both
// places, so a tree that says four and a machine that runs one cannot happen.
let vcpus = fn (u: unit) ->
  let t = match env_var "MVM_VCPUS" with | Some x -> x | None -> "" in
  // A number, or one. int_of_str stops the program on anything else, and this
  // came from a person's environment.
  let v = (let n = str_len t in
           if n == 0 then 1
           else
             let rec go = fn (i: int) -> fn (acc: int) ->
               if i == n then acc
               else
                 let c = ord (char_at t i) in
                 if c < 48 || c > 57 then 0 - 1
                 else go (i + 1) (acc * 10 + (c - 48)) in
             let r = go 0 0 in
             if r <= 0 then 1 else r) in
  if v < 1 then 1 else if v > 64 then 64 else v;

// AS MANY REDISTRIBUTORS AS THERE ARE CPUS -- not the region the framework
// reserves.
//
// The framework's region is 33,554,432 bytes (256 redistributors at 131,072
// each), and writing THAT into the tree put the redistributors on top of the
// UART: this machine's map is redistributors at 0x80a0000 and the PL011 at
// 0x9000000, which is 16 MiB above, and 32 MiB swallows it. Every gate that
// starts a machine went red at once.
//
// The tree describes what is THERE. One redistributor per CPU, which is the
// old value exactly when there is one CPU. The room between 0x80a0000 and the
// UART holds 123 of them, so the map does not need moving for any number this
// is ever going to run.
let redist_reg = fn (n: int) -> n * hv_gic_redist_size ();

match args () with
| [out, initrd_start, initrd_end] ->
    let _ = hv_up () in
    let ds = hv_gic_dist_size () in
    let rs = redist_reg (vcpus ()) in
    let _ = if ds <= 0 then let _ = print_err "mkdtb: no distributor size" in exit 1 else 0 in
    let b = build (bootargs_or "earlycon=pl011,0x9000000 console=ttyAMA0 panic=-1 rdinit=/init")
                  ds rs (int_of_str initrd_start) (int_of_str initrd_end) (vcpus ()) in
    let _ = write_bytes out b in
    print_err ("mkdtb: wrote " ++ out ++ " with an initrd")
| [out] ->
    // A VM has to exist before the framework will answer for its GIC.
    let _ = hv_up () in
    let ds = hv_gic_dist_size () in
    let rs = redist_reg (vcpus ()) in
    let _ = if ds <= 0 then let _ = print_err "mkdtb: the framework would not give a distributor size" in exit 1 else 0 in
    let _ = if rs <= 0 then let _ = print_err "mkdtb: the framework would not give a redistributor size" in exit 1 else 0 in
    let b = build (bootargs_or "earlycon=pl011,0x9000000 console=ttyAMA0 panic=-1") ds rs 0 0 (vcpus ()) in
    let _ = write_bytes out b in
    print_err ("mkdtb: wrote " ++ out ++ "  (" ++ show (vcpus ()) ++ " cpu, gic dist 0x"
            ++ show ds ++ ", redist region 0x" ++ show rs ++ ")")
| _ -> let _ = print_err "usage: mkdtb <out.dtb>" in exit 2
