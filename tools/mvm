#!/bin/sh
# tools/mvm — bring a machine up, and put it away.
#
# Everything this does was already possible; it was six pieces assembled by
# hand, and that is the difference between "the stack works" and "somebody uses
# it". The pieces are a guest disk, a device tree, the VMM, the port watcher,
# and a docker client pointed at the right socket.
#
#   mvm build [--kernel [--version V | --from-dir DIR]
#                       [--from-source [--kversion 6.8]]]
#   mvm package
#   mvm start [--name N] [--disk-size MiB] [--ram MB] [--cpus N]
#             [-p|--publish HOST:GUEST]... [--proxy-port P | --no-proxy]
#             [--proxy-everywhere]
#   mvm stop  [--name N]
#   mvm status [--name N]
#   mvm doctor
#
# State lives in one directory per machine, $MVM_HOME/<name> (default
# ~/.mvm/<name>), because the second machine is not a special case -- test/two.sh
# showed two running side by side, and a layout that assumes one would have to
# be undone to allow it.
set -u
here="$(cd "$(dirname "$0")/.." && pwd)"
out="$here/.build"
# A RELEASE HAS THEM AT THE TOP. In a checkout everything is built into
# .build; in an unpacked tarball there is no build directory and the Image is
# right there. The same tool runs from both, and the difference is one line
# rather than a second script that would have to be kept in step.
[ -r "$here/Image" ] && out="$here"
# WHICH VMM TO RUN. One name, so a gate can start a machine with a variant it
# built -- test/bigdisk.sh runs a deliberately broken one -- without swapping
# the real binary in place, where an interrupted run would leave it.
VMM="${MVM_BOOT:-$out/mvm-boot}"
MVM_HOME="${MVM_HOME:-$HOME/.mvm}"
NAME=default
DISK_MB=20480
RAM_MB="${MVM_RAM_MB:-4096}"
# ONE, because more is not free. A second CPU buys nothing on the operations
# this is quickest at -- docker ps and docker run are a round trip, not
# arithmetic -- and it buys a great deal when something is busy next to
# something else: a web service beside three workers went from 530 ms to 100.
# See test/vcpus.sh for the table.
CPUS="${MVM_VCPUS:-1}"
PORTS=""
# THE WAY OUT. This guest has no network interface at all -- the VMM shows it a
# block device and vsock, and nothing else -- so anything inside it that wants
# to reach the world does it by asking a proxy on this side. Without one, a
# `docker build` step cannot `apk add` and a container cannot reach an API.
#
# It was always possible and never automatic: test/hub.sh started mproxy by
# hand and passed three environment variables, which is the difference between
# "the stack can do it" and "the tool does it".
PROXY_PORT="${MVM_PROXY_PORT:-3128}"
PROXY_PINNED=0        # 1 once somebody names the port, and then it is theirs
USE_PROXY=1
KERNEL_ONLY=0
KVER=""
KDIR=""
KSRC=0
KKVER=""

usage() {
  # BY CONTENT, NOT BY LINE NUMBER. This was `sed -n '3,14p'`, and adding one
  # line to the block above silently pushed `mvm status` and `mvm doctor` off
  # the end of the help -- the tool still accepted them and stopped saying so.
  # Here the block ends where it actually ends: the first bare `#` after the
  # command list. tools/checkopts.sh is the check that nothing is accepted
  # without being named here.
  awk 'NR < 3 { next }
       /^#   mvm /  { seen = 1 }
       seen && /^#$/ { exit }
       /^#/ { sub(/^#[ ]?/, ""); print; next }
       { exit }' "$0"
  exit 2
}

cmd="${1:-}"; [ -n "$cmd" ] || usage
shift 2>/dev/null || true
while [ $# -gt 0 ]; do
  case "$1" in
    --name) NAME="$2"; shift 2;;
    --disk-size) DISK_MB="$2"; shift 2;;
    --ram) RAM_MB="$2"; shift 2;;
    --cpus) CPUS="$2"; shift 2;;
    -p|--publish) PORTS="$PORTS $2"; shift 2;;
    --proxy-port) PROXY_PORT="$2"; PROXY_PINNED=1; shift 2;;
    # WHO IS TOLD WHERE THE WAY OUT IS.
    #
    # By default only containers on the default bridge, because a network
    # somebody created is one they said what belongs on. But `docker compose`
    # creates a network for every project, so by default no compose service can
    # reach anything outside -- measured: a container on a created network gets
    # zero proxy variables and plain http fails. This hands the same address to
    # every container instead. The daemon has always been able to do it; there
    # was no way to ask for it from here.
    --proxy-everywhere) PROXY_EVERYWHERE=1; shift;;
    --no-proxy) USE_PROXY=0; shift;;
    --kernel) KERNEL_ONLY=1; shift;;
    --version) KVER="$2"; shift 2;;
    --from-dir) KDIR="$2"; shift 2;;
    --from-source) KSRC=1; shift;;
    --kversion) KKVER="$2"; shift 2;;
    *) echo "mvm: unknown option $1" >&2; usage;;
  esac
done
D="$MVM_HOME/$NAME"
SOCK="$D/docker.sock"
CTL="$D/control.sock"

# WHAT THIS MACHINE NEEDS, each named. A missing kernel and a missing module
# are different sentences, and "it did not start" is neither of them.
# Where a guest binary is: built here, or in the checkout it came from.
# WHAT THE INITRAMFS CARRIES.
#
# The guest's programs and the kernel's modules used to be checked as files in
# .build, which was right while the disk was built here and copied them in.
# They travel inside initrd-format.gz now, and the machine takes them from
# there -- so a release does not contain .build/guest or .build/extra at all,
# and a doctor that looked for them would report a working release broken.
#
# Listed once: the archive is 10 MB and decompressing it per question is four
# times the work for the same answer.
ird_list() {
  [ -r "$out/initrd-format.gz" ] || return 0
  gzip -dc "$out/initrd-format.gz" 2>/dev/null | cpio -t 2>/dev/null
}

doctor() {
  rc=0
  IRD="$(ird_list)"
  chk() { if [ -r "$2" ] || [ -x "$2" ]; then echo "  ok    $1"; else echo "  MISSING $1 -- $3"; rc=1; fi; }

  # THE MACHINE THIS IS RUNNING ON, FIRST, because it is the one thing here
  # that cannot be fixed by building something. The interrupt controller is
  # hv_gic_create and the eight calls around it, all API_AVAILABLE(macos(15.0));
  # on macOS 14 the loader refuses the VMM for a missing symbol before it can
  # say anything of its own, and the person reading that has no way to know
  # what it means. Said here instead, once, in a sentence.
  echo "== the machine this is running on =="
  osv="$(sw_vers -productVersion 2>/dev/null)"
  arch="$(uname -m 2>/dev/null)"
  case "$arch" in
    arm64) echo "  ok    Apple silicon ($arch)";;
    *)     echo "  MISSING Apple silicon -- this is $arch, and the guest is arm64"; rc=1;;
  esac
  case "${osv%%.*}" in
    ''|*[!0-9]*) echo "  MISSING a macOS version -- sw_vers said '${osv:-nothing}'"; rc=1;;
    *) if [ "${osv%%.*}" -ge 15 ]; then echo "  ok    macOS $osv (15.0 or newer, which hv_gic_* needs)"
       else echo "  MISSING macOS 15.0 or newer -- this is $osv, and hv_gic_create does not exist before 15.0"; rc=1; fi;;
  esac

  echo "== what a machine is made of =="
  chk "an arm64 kernel Image"      "$out/Image"     "gunzip -c /boot/vmlinuz-\$(uname -r) > .build/Image, on a Linux box with that kernel"
  chk "the VMM"                    "$VMM"           "sh test/stack.sh builds it, or build boot.mere yourself"
  chk "the device tree writer"     "$out/mkdtb"     "same"
  chk "the port watcher"           "$out/mports"    "same"
  chk "the way out (a CONNECT proxy)" "$out/mproxy" "same -- without it nothing inside can reach the network"
  chk "the initramfs that makes a disk" "$out/initrd-format.gz" "sh tools/mkinitrd.sh -- the guest formats its own disk, because macOS cannot write ext4"

  # EIGHT FILES, OR A KERNEL THAT NEEDS NONE. Which it is comes from
  # kernel.lock, because the difference is a property of how the Image was
  # made: one taken out of a package is built for somebody else's machine and
  # has these as modules; one built here has them in it.
  inird() { if echo "$IRD" | grep -qx "payload/$1"; then echo "  ok    $2"; else echo "  MISSING $2 -- sh tools/mkbuild.sh"; rc=1; fi; }
  if [ "$(awk '/^modules /{print $2}' "$out/kernel.lock" 2>/dev/null)" = built-in ]; then
    echo "  ok    the kernel has overlay, vsock, bridge and veth built in (no modules to ship)"
  else
    n=$(echo "$IRD" | grep -c "^payload/opt/.*\.ko$")
    if [ "$n" = 8 ]; then echo "  ok    eight kernel modules, in the initramfs"
    else echo "  MISSING kernel modules -- the initramfs carries $n of 8; sh tools/mvm build --kernel then sh tools/mkbuild.sh"; rc=1; fi
  fi
  inird "opt/mengd"          "the daemon for the guest"
  inird "opt/mrun"           "the runtime for the guest"
  inird "opt/mfwd"           "the forwarder for the guest"
  inird "init-mengd-disk"    "the init the machine boots"
  # WHICH kernel, not just that there is one. Two machines with the same tool
  # and different kernels behave differently, and the difference is invisible
  # until something a module provides is missing.
  if [ -r "$out/kernel.lock" ]; then
    echo "  ok    the kernel is $(awk '/^version /{print $2}' "$out/kernel.lock") ($(awk '/Image$/{print substr($1,1,12)}' "$out/kernel.lock"))"
  else
    echo "  ok    a kernel is present, but nothing records which -- sh tools/mkkernel.sh writes .build/kernel.lock"
  fi
  # QUARANTINE. A binary that arrived in a download carries an attribute that
  # makes macOS refuse to run it, and the refusal names Gatekeeper rather than
  # this tool. Nothing here can remove it for the user -- that is the point of
  # it -- so it is named.
  if xattr -p com.apple.quarantine "$VMM" >/dev/null 2>&1; then
    echo "  MISSING permission to run the VMM -- it is quarantined; xattr -d com.apple.quarantine $VMM"
    rc=1
  fi
  orphans
  codesign -dv "$VMM" 2>&1 | grep -q "Signature" \
    && echo "  ok    the VMM is signed (Hypervisor.framework refuses an unsigned one)" \
    || { echo "  MISSING a signature on $VMM -- codesign --sign - --force --entitlements mvm.entitlements"; rc=1; }
  return $rc
}

running() {
  [ -r "$D/vmm.pid" ] || return 1
  kill -0 "$(cat "$D/vmm.pid")" 2>/dev/null
}

# THE DISK, MADE BY THE MACHINE THAT WILL USE IT.
#
# It used to be made here, with `docker create` for the tree and a container
# running mke2fs for the filesystem -- which means a tool that replaces docker
# needed docker to install, on a system that has nothing else that writes ext4.
#
# The host makes a file of the right size, which is all `dd` does, and the
# guest does the rest: one boot of the format initramfs, about four seconds,
# and then it powers itself off. The RUNNING path is untouched -- that is why
# this powers off rather than switch_root, since the ordinary boot is the one
# every check here is green against.
#
# It runs again when the initramfs changes, in `refresh` mode, which copies the
# daemon and the runtime in without touching the filesystem. Before that,
# upgrading this tool meant deleting the machine.
ensure_disk() {
  ird="$out/initrd-format.gz"
  want="$(shasum -a 256 "$ird" 2>/dev/null | cut -d' ' -f1)"
  mode=""
  if [ ! -r "$D/disk.img" ]; then
    echo "mvm: making a ${DISK_MB} MiB disk (this is decided once; growing it means making a new one)"
    # Sparse: the file is as big as it says and costs what is written to it.
    dd if=/dev/zero of="$D/disk.img" bs=1m count=0 seek="$DISK_MB" 2>/dev/null \
      || { echo "mvm: could not make $D/disk.img" >&2; exit 1; }
    mode=format
  elif [ "$want" != "$(cat "$D/initrd.id" 2>/dev/null)" ]; then
    echo "mvm: this tool has been rebuilt -- installing the new guest programs"
    mode=refresh
  fi
  [ -n "$mode" ] || return 0

  sz=$(stat -f%z "$ird")
  istart=$((0x4a000000)); iend=$((istart + sz))
  MVM_BOOTARGS="earlycon=pl011,0x9000000 console=ttyAMA0 panic=-1 MVM_FORMAT=$mode" \
  MVM_RAM_MB="$RAM_MB" MVM_VCPUS=1 "$out/mkdtb" "$D/format.dtb" "$istart" "$iend" >/dev/null 2>&1 \
    || { echo "mvm: could not write the device tree for the format boot" >&2; exit 1; }
  # A DEADLINE, because this one is not a machine somebody is using: if it does
  # not finish it has hung, and a hang here would be a start that never returns.
  # One CPU to make a filesystem: the formatter runs mke2fs and copies files,
  # and nothing about that is faster on four.
  MVM_RAM_MB="$RAM_MB" MVM_VCPUS=1 MVM_TIMEOUT_MS=300000 \
    "$VMM" "$out/Image" "$D/format.dtb" "$ird" "$D/disk.img" \
    > "$D/format.log" 2>&1
  if ! grep -qa "format: done" "$D/format.log"; then
    echo "mvm: the guest could not prepare its disk:" >&2
    grep -a "format:" "$D/format.log" | sed 's/^.*format: /  /' >&2
    exit 1
  fi
  grep -a "format:" "$D/format.log" | sed 's/^.*format: /  disk: /'
  echo "$want" > "$D/initrd.id"
}

start() {
  doctor >/dev/null 2>&1 || { doctor; echo "mvm: not starting until those are there" >&2; exit 1; }
  if running; then echo "mvm: $NAME is already running (pid $(cat "$D/vmm.pid"))"; exit 0; fi
  mkdir -p "$D"
  ensure_disk
  # Published ports are agreed in advance here, because opening the host's end
  # is the host's job: the convention is that the vsock port IS the host port.
  inward="$SOCK=1024"
  for p in $PORTS; do
    h="${p%%:*}"; g="${p##*:}"
    inward="$inward,tcp:$h=$g"
  done
  # The way out, before the machine that will use it.
  #
  # Three facts have to agree, and they are written here once: the host port
  # the proxy listens on, the vsock port the VMM carries to it, and the address
  # the guest is told to use. The convention everywhere else in this tool --
  # the vsock port IS the host port -- holds here too.
  #
  # ITS OWN, ON A FREE PORT. The first version reused whatever was already
  # listening on 3128, which is wrong in the case that matters: 3128 is squid's
  # port, and a machine that finds a stranger there would send everything
  # inside it to that stranger. So the default port is a STARTING POINT and the
  # first free one above it is taken. A port somebody names with --proxy-port
  # is theirs: if it is busy, that is an error and not a reason to use another.
  outward=""; bootproxy=""
  if [ "$USE_PROXY" = 1 ] && [ -x "$out/mproxy" ]; then
    if [ "$PROXY_PINNED" = 0 ]; then
      tries=0
      while nc -z 127.0.0.1 "$PROXY_PORT" 2>/dev/null && [ "$tries" -lt 64 ]; do
        PROXY_PORT=$((PROXY_PORT + 1)); tries=$((tries + 1))
      done
    fi
    if nc -z 127.0.0.1 "$PROXY_PORT" 2>/dev/null; then
      echo "mvm: 127.0.0.1:$PROXY_PORT is busy and was asked for by name -- nothing inside will reach the network" >&2
    else
      "$out/mproxy" "$PROXY_PORT" > "$D/mproxy.log" 2>&1 &
      echo $! > "$D/mproxy.pid"
      i=0
      while [ "$i" -lt 40 ] && ! nc -z 127.0.0.1 "$PROXY_PORT" 2>/dev/null; do sleep 0.25; i=$((i + 1)); done
      nc -z 127.0.0.1 "$PROXY_PORT" 2>/dev/null \
        || { echo "mvm: the proxy did not come up on $PROXY_PORT; see $D/mproxy.log" >&2
             rm -f "$D/mproxy.pid"; }
    fi
    if [ -r "$D/mproxy.pid" ] && nc -z 127.0.0.1 "$PROXY_PORT" 2>/dev/null; then
      outward="$PROXY_PORT=tcp:$PROXY_PORT"
      # MVM_FWD_OUT puts a forwarder inside the guest on 0.0.0.0:<port>, which
      # is where a CONTAINER reaches it -- on the bridge address, not 127.0.0.1,
      # which in a container is its own loopback. MENGD_PROXY is the daemon's
      # own copy, in the machine's namespace, where 127.0.0.1 is right.
      bootproxy=" MVM_FWD_OUT=$PROXY_PORT:$PROXY_PORT MENGD_PROXY=127.0.0.1:$PROXY_PORT"
      [ "${PROXY_EVERYWHERE:-0}" = 1 ] && bootproxy="$bootproxy MENGD_CONTAINER_PROXY=all"
    fi
  fi
  # No deadline: a machine somebody started is not on a timer.
  # The tree and the machine are told the same number by the same variable:
  # a tree that says four and a VMM that runs one is a guest looking for CPUs
  # that are not there.
  MVM_BOOTARGS="earlycon=pl011,0x9000000 console=ttyAMA0 panic=-1 root=/dev/vda rw init=/sbin/init$bootproxy" \
  MVM_RAM_MB="$RAM_MB" MVM_VCPUS="$CPUS" "$out/mkdtb" "$D/machine.dtb" >/dev/null 2>&1 \
    || { echo "mvm: could not write the device tree" >&2; exit 1; }
  rm -f "$SOCK" "$CTL"
  # DIRECTLY in the background, not in a subshell: ( cmd ) & gives back the
  # SUBSHELL's pid, and killing that leaves the VM running -- which is not a
  # tidy-up problem, because the next start binds the same socket, fails, and
  # the OLD guest answers it.
  MVM_VSOCK_IN="$inward" \
  MVM_VSOCK_OUT="$outward" \
  MVM_CONTROL="$CTL" \
  MVM_RAM_MB="$RAM_MB" \
  MVM_VCPUS="$CPUS" \
      "$VMM" "$out/Image" "$D/machine.dtb" "" "$D/disk.img" \
      > "$D/console.log" 2> "$D/vmm.log" &
  echo $! > "$D/vmm.pid"
  i=0
  while [ "$i" -lt 240 ]; do
    grep -qa "listening on" "$D/console.log" 2>/dev/null && break
    kill -0 "$(cat "$D/vmm.pid")" 2>/dev/null || { echo "mvm: the machine stopped while starting; see $D/vmm.log" >&2; exit 1; }
    sleep 0.5; i=$((i + 1))
  done
  grep -qa "listening on" "$D/console.log" || { echo "mvm: the daemon never came up; see $D/console.log" >&2; exit 1; }
  "$out/mports" "$SOCK" "$CTL" 400 > "$D/mports.log" 2>&1 &
  echo $! > "$D/mports.pid"
  # The client's end. A context rather than an exported variable, so it
  # survives a new terminal.
  #
  # AN EXISTING ONE THAT ALREADY POINTS HERE IS LEFT ALONE. The socket path is
  # derived from the machine's name, so the context a previous start made is
  # still correct -- and `docker context rm` REFUSES the context the user is
  # currently using, which made `mvm stop && mvm start` print the DOCKER_HOST
  # fallback as though the context could not be made, while the context sitting
  # there worked perfectly well.
  want="unix://$SOCK"
  have="$(docker context inspect "mvm-$NAME" --format '{{.Endpoints.docker.Host}}' 2>/dev/null)"
  if [ "$have" = "$want" ]; then
    echo "mvm: $NAME is up -- docker context use mvm-$NAME"
  else
    [ -n "$have" ] && docker context rm "mvm-$NAME" >/dev/null 2>&1
    docker context create "mvm-$NAME" --docker "host=$want" >/dev/null 2>&1 \
      && echo "mvm: $NAME is up -- docker context use mvm-$NAME" \
      || echo "mvm: $NAME is up -- export DOCKER_HOST=$want"
  fi
  grep -a "userspace: \(overlay mounts\|bridge and veth\)" "$D/console.log" | sed 's/^.*userspace: /  guest: /'
}

stop() {
  if [ -r "$D/mports.pid" ]; then kill "$(cat "$D/mports.pid")" 2>/dev/null; rm -f "$D/mports.pid"; fi
  # Only the one this machine started. A proxy that was already there when it
  # started belongs to somebody else.
  if [ -r "$D/mproxy.pid" ]; then kill "$(cat "$D/mproxy.pid")" 2>/dev/null; rm -f "$D/mproxy.pid"; fi
  if ! running; then echo "mvm: $NAME is not running"; rm -f "$D/vmm.pid" "$SOCK" "$CTL"; return 0; fi
  pid="$(cat "$D/vmm.pid")"
  # ASK THE MACHINE TO STOP BEFORE KILLING IT. Killing the VMM loses whatever
  # the guest has not committed yet: a machine stopped a second after a
  # container was created came back without it. The daemon flushes and powers
  # the machine off, and the VMM exits on its own.
  if [ -S "$SOCK" ]; then
    curl -s --max-time 10 --unix-socket "$SOCK" -X POST http://x/_shutdown >/dev/null 2>&1
    i=0
    while [ "$i" -lt 60 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.25; i=$((i + 1)); done
  fi
  kill "$pid" 2>/dev/null
  # And escalate. A VMM inside the framework's run() does not always go on the
  # first signal, and a half-stopped machine still holds the socket the next
  # start wants.
  i=0
  while [ "$i" -lt 40 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.25; i=$((i + 1)); done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
    i=0
    while [ "$i" -lt 40 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.25; i=$((i + 1)); done
  fi
  kill -0 "$pid" 2>/dev/null && { echo "mvm: $NAME would not stop (pid $pid)" >&2; exit 1; }
  rm -f "$D/vmm.pid" "$SOCK" "$CTL"
  echo "mvm: $NAME stopped"
}

# MACHINES NOBODY CAN STOP.
#
# `stop` reads $D/vmm.pid, so a state directory that has been deleted leaves a
# VMM -- and its proxy -- running with nothing in the tool that can reach them.
# It happens: a machine made for one thing, its directory removed, and the
# machine still there. Nothing said so until it was found in ps.
#
# Named here rather than cleaned up: killing something whose directory somebody
# removed is a decision for the person who removed it.
orphans() {
  found=""
  for p in $(pgrep -f "$VMM" 2>/dev/null); do
    owned=no
    for d in "$MVM_HOME"/*/; do
      [ -r "$d/vmm.pid" ] && [ "$(cat "$d/vmm.pid" 2>/dev/null)" = "$p" ] && owned=yes
    done
    [ "$owned" = no ] && found="$found $p"
  done
  for p in $(pgrep -f "$out/mproxy" 2>/dev/null); do
    owned=no
    for d in "$MVM_HOME"/*/; do
      [ -r "$d/mproxy.pid" ] && [ "$(cat "$d/mproxy.pid" 2>/dev/null)" = "$p" ] && owned=yes
    done
    [ "$owned" = no ] && found="$found $p"
  done
  [ -n "$found" ] || return 0
  echo "  orphans  $(echo $found | tr ' ' ',') -- running, and no machine in $MVM_HOME owns them"
  echo "           (a state directory was removed while its machine was up; kill them by pid)"
}

status() {
  if running; then
    echo "mvm: $NAME running (pid $(cat "$D/vmm.pid"))"
    echo "     socket   unix://$SOCK"
    echo "     disk     $D/disk.img ($(du -h "$D/disk.img" 2>/dev/null | cut -f1))"
    echo "     cpus     $(grep -ao '[0-9]* cpus' "$D/vmm.log" 2>/dev/null | head -1 | cut -d' ' -f1 || echo 1)"
    if grep -qa "MENGD_PROXY=" "$D/console.log" 2>/dev/null; then
      echo "     outward  through a proxy on this machine (containers on the default bridge get it)"
    else
      echo "     outward  none -- nothing inside can reach the network"
    fi
    grep -a "userspace: \(overlay mounts\|bridge and veth\)" "$D/console.log" 2>/dev/null | sed 's/^.*userspace: /     guest:   /'
  else
    echo "mvm: $NAME is not running"
    [ -r "$D/disk.img" ] && echo "     its disk is still at $D/disk.img"
  fi
  orphans
}

build() {
  if [ "$KERNEL_ONLY" = 1 ]; then
    set --
    [ "$KSRC" = 1 ] && set -- "$@" --from-source
    [ -n "$KKVER" ] && set -- "$@" --kversion "$KKVER"
    [ -n "$KVER" ] && set -- "$@" --version "$KVER"
    [ -n "$KDIR" ] && set -- "$@" --from-dir "$KDIR"
    sh "$here/tools/mkkernel.sh" "$@"
  else
    sh "$here/tools/mkbuild.sh"
  fi
}

case "$cmd" in
  build) build;;
  package) sh "$here/tools/mkpackage.sh";;
  start) start;;
  stop) stop;;
  status) status;;
  doctor) doctor;;
  *) usage;;
esac
