#!/bin/sh
# tools/mvm — bring a machine up, and put it away.
#
# Everything this does was already possible; it was six pieces assembled by
# hand, and that is the difference between "the stack works" and "somebody uses
# it". The pieces are a guest disk, a device tree, the VMM, the port watcher,
# and a docker client pointed at the right socket.
#
#   mvm start [--name N] [--disk-size MiB] [--ram MB] [-p HOST:GUEST]...
#   mvm stop  [--name N]
#   mvm status [--name N]
#   mvm doctor
#
# State lives in one directory per machine, $MVM_HOME/<name> (default
# ~/.mvm/<name>), because the second machine is not a special case -- test/two.sh
# showed two running side by side, and a layout that assumes one would have to
# be undone to allow it.
set -u
here="$(cd "$(dirname "$0")/.." && pwd)"
out="$here/.build"
MVM_HOME="${MVM_HOME:-$HOME/.mvm}"
NAME=default
DISK_MB=20480
RAM_MB="${MVM_RAM_MB:-4096}"
PORTS=""

usage() {
  sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

cmd="${1:-}"; [ -n "$cmd" ] || usage
shift 2>/dev/null || true
while [ $# -gt 0 ]; do
  case "$1" in
    --name) NAME="$2"; shift 2;;
    --disk-size) DISK_MB="$2"; shift 2;;
    --ram) RAM_MB="$2"; shift 2;;
    -p|--publish) PORTS="$PORTS $2"; shift 2;;
    *) echo "mvm: unknown option $1" >&2; usage;;
  esac
done
D="$MVM_HOME/$NAME"
SOCK="$D/docker.sock"
CTL="$D/control.sock"

# WHAT THIS MACHINE NEEDS, each named. A missing kernel and a missing module
# are different sentences, and "it did not start" is neither of them.
doctor() {
  rc=0
  chk() { if [ -r "$2" ] || [ -x "$2" ]; then echo "  ok    $1"; else echo "  MISSING $1 -- $3"; rc=1; fi; }
  echo "== what a machine is made of =="
  chk "an arm64 kernel Image"      "$out/Image"     "gunzip -c /boot/vmlinuz-\$(uname -r) > .build/Image, on a Linux box with that kernel"
  chk "the VMM"                    "$out/mvm-boot"  "sh test/stack.sh builds it, or build boot.mere yourself"
  chk "the device tree writer"     "$out/mkdtb"     "same"
  chk "the port watcher"           "$out/mports"    "same"
  for m in vsock vmw_vsock_virtio_transport_common vmw_vsock_virtio_transport overlay veth bridge stp llc; do
    chk "module $m.ko" "$out/extra/$m.ko" "from /lib/modules/\$(uname -r) of THAT kernel; each one missing costs a feature"
  done
  chk "the daemon for the guest"   "${MENGD_SRC:-}/.build/mengd-linux" "set MENGD_SRC and build it for linux/arm64"
  chk "the runtime for the guest"  "${MRUN_SRC:-}/.build/mrun-linux"   "set MRUN_SRC and build it for linux/arm64"
  codesign -dv "$out/mvm-boot" 2>&1 | grep -q "Signature" \
    && echo "  ok    the VMM is signed (Hypervisor.framework refuses an unsigned one)" \
    || { echo "  MISSING a signature on $out/mvm-boot -- codesign --sign - --force --entitlements mvm.entitlements"; rc=1; }
  return $rc
}

running() {
  [ -r "$D/vmm.pid" ] || return 1
  kill -0 "$(cat "$D/vmm.pid")" 2>/dev/null
}

start() {
  doctor >/dev/null 2>&1 || { doctor; echo "mvm: not starting until those are there" >&2; exit 1; }
  if running; then echo "mvm: $NAME is already running (pid $(cat "$D/vmm.pid"))"; exit 0; fi
  mkdir -p "$D"
  # The guest's payload: the daemon, the runtime, the forwarder, the modules.
  payload="$D/payload"; rm -rf "$payload"; mkdir -p "$payload"
  cp "$out"/extra/*.ko "$payload/" 2>/dev/null
  cp "$MENGD_SRC/.build/mengd-linux" "$payload/mengd"
  cp "$MRUN_SRC/.build/mrun-linux" "$payload/mrun"
  [ -x "$out/mfwd-linux" ] && cp "$out/mfwd-linux" "$payload/mfwd"
  chmod 755 "$payload"/mengd "$payload"/mrun "$payload"/mfwd 2>/dev/null
  if [ ! -r "$D/disk.img" ]; then
    echo "mvm: making a ${DISK_MB} MiB disk (this is decided once; growing it means making a new one)"
    # The reason, not a summary of it. mkrootfs builds the image inside a
    # container with the target directory bind-mounted, so a state directory
    # the container runtime does not share (anything outside $HOME, usually)
    # fails in a way only its own output explains.
    sh "$here/tools/mkrootfs.sh" "$D/disk.img" "$DISK_MB" "$payload" > "$D/mkrootfs.log" 2>&1 \
      || { echo "mvm: could not build the guest disk:" >&2; tail -3 "$D/mkrootfs.log" >&2
           echo "mvm: (MVM_HOME is $MVM_HOME -- it has to be somewhere the container runtime shares)" >&2
           exit 1; }
  fi
  # Published ports are agreed in advance here, because opening the host's end
  # is the host's job: the convention is that the vsock port IS the host port.
  inward="$SOCK=1024"
  for p in $PORTS; do
    h="${p%%:*}"; g="${p##*:}"
    inward="$inward,tcp:$h=$g"
  done
  # No deadline: a machine somebody started is not on a timer.
  MVM_BOOTARGS="earlycon=pl011,0x9000000 console=ttyAMA0 panic=-1 root=/dev/vda rw init=/sbin/init" \
  MVM_RAM_MB="$RAM_MB" "$out/mkdtb" "$D/machine.dtb" >/dev/null 2>&1 \
    || { echo "mvm: could not write the device tree" >&2; exit 1; }
  rm -f "$SOCK" "$CTL"
  # DIRECTLY in the background, not in a subshell: ( cmd ) & gives back the
  # SUBSHELL's pid, and killing that leaves the VM running -- which is not a
  # tidy-up problem, because the next start binds the same socket, fails, and
  # the OLD guest answers it.
  MVM_VSOCK_IN="$inward" \
  MVM_CONTROL="$CTL" \
  MVM_RAM_MB="$RAM_MB" \
      "$out/mvm-boot" "$out/Image" "$D/machine.dtb" "" "$D/disk.img" \
      > "$D/console.log" 2> "$D/vmm.log" &
  echo $! > "$D/vmm.pid"
  i=0
  while [ "$i" -lt 240 ]; do
    grep -qa "listening on" "$D/console.log" 2>/dev/null && break
    kill -0 "$(cat "$D/vmm.pid")" 2>/dev/null || { echo "mvm: the machine stopped while starting; see $D/vmm.log" >&2; exit 1; }
    sleep 0.5; i=$((i + 1))
  done
  grep -qa "listening on" "$D/console.log" || { echo "mvm: the daemon never came up; see $D/console.log" >&2; exit 1; }
  "$out/mports" "$SOCK" "$CTL" 400 > "$D/mports.log" 2>&1 &
  echo $! > "$D/mports.pid"
  # The client's end. A context rather than an exported variable, so it
  # survives a new terminal.
  docker context rm "mvm-$NAME" >/dev/null 2>&1
  docker context create "mvm-$NAME" --docker "host=unix://$SOCK" >/dev/null 2>&1 \
    && echo "mvm: $NAME is up -- docker context use mvm-$NAME" \
    || echo "mvm: $NAME is up -- export DOCKER_HOST=unix://$SOCK"
  grep -a "userspace: \(overlay mounts\|bridge and veth\)" "$D/console.log" | sed 's/^.*userspace: /  guest: /'
}

stop() {
  if [ -r "$D/mports.pid" ]; then kill "$(cat "$D/mports.pid")" 2>/dev/null; rm -f "$D/mports.pid"; fi
  if ! running; then echo "mvm: $NAME is not running"; rm -f "$D/vmm.pid" "$SOCK" "$CTL"; return 0; fi
  pid="$(cat "$D/vmm.pid")"
  # ASK THE MACHINE TO STOP BEFORE KILLING IT. Killing the VMM loses whatever
  # the guest has not committed yet: a machine stopped a second after a
  # container was created came back without it. The daemon flushes and powers
  # the machine off, and the VMM exits on its own.
  if [ -S "$SOCK" ]; then
    curl -s --max-time 10 --unix-socket "$SOCK" -X POST http://x/_shutdown >/dev/null 2>&1
    i=0
    while [ "$i" -lt 60 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.25; i=$((i + 1)); done
  fi
  kill "$pid" 2>/dev/null
  # And escalate. A VMM inside the framework's run() does not always go on the
  # first signal, and a half-stopped machine still holds the socket the next
  # start wants.
  i=0
  while [ "$i" -lt 40 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.25; i=$((i + 1)); done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
    i=0
    while [ "$i" -lt 40 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.25; i=$((i + 1)); done
  fi
  kill -0 "$pid" 2>/dev/null && { echo "mvm: $NAME would not stop (pid $pid)" >&2; exit 1; }
  rm -f "$D/vmm.pid" "$SOCK" "$CTL"
  echo "mvm: $NAME stopped"
}

status() {
  if running; then
    echo "mvm: $NAME running (pid $(cat "$D/vmm.pid"))"
    echo "     socket   unix://$SOCK"
    echo "     disk     $D/disk.img ($(du -h "$D/disk.img" 2>/dev/null | cut -f1))"
    grep -a "userspace: \(overlay mounts\|bridge and veth\)" "$D/console.log" 2>/dev/null | sed 's/^.*userspace: /     guest:   /'
  else
    echo "mvm: $NAME is not running"
    [ -r "$D/disk.img" ] && echo "     its disk is still at $D/disk.img"
  fi
}

case "$cmd" in
  start) start;;
  stop) stop;;
  status) status;;
  doctor) doctor;;
  *) usage;;
esac
