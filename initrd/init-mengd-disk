#!/bin/sh
# initrd/init-mengd-disk — pid 1 on a real root filesystem.
#
# The same job as init-mengd, minus the reason it could not finish it: here /
# is an ext4 mount on virtio-blk rather than the initramfs, so pivot_root works
# and mrun can actually enter a container.
mkdir -p /dev /proc /sys 2>/dev/null
mount -t devtmpfs dev /dev 2>/dev/null
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sys /sys 2>/dev/null
say() { echo "userspace: $1" > /dev/kmsg; }
say "init-mengd-disk starting on $(mount | grep ' / ' | head -1)"

# The VMM put the time on the command line, and the kernel hands an
# unrecognised key=value to init as an environment variable. Without it every
# timestamp this daemon produces is 1970, and the clients that read those
# fields parse them.
[ -n "${MVM_EPOCH:-}" ] && date -s "@$MVM_EPOCH" >/dev/null 2>&1
say "clock says $(date -u +%Y-%m-%dT%H:%M:%SZ)"
[ -e /sys/bus/amba/devices/9010000.pl031 ] \
  && say "the amba bus enumerated 9010000.pl031" \
  || say "no pl031 on the amba bus"

for m in vsock vmw_vsock_virtio_transport_common vmw_vsock_virtio_transport; do
  insmod /opt/$m.ko 2>/dev/null || say "insmod $m FAILED"
done
say "vsock modules loaded"

# overlayfs. A build step's layer IS the upper directory of an overlay mount,
# so without this the daemon can only write the whole root filesystem as one
# layer. It is =m in a stock kernel like vsock is.
#
# Said out loud at boot rather than discovered at build time: the module being
# absent and the mount being refused produce the same symptom hours later, and
# this is the only place that can tell them apart.
if [ -r /opt/overlay.ko ]; then
  insmod /opt/overlay.ko 2>/dev/null || say "insmod overlay FAILED"
  mkdir -p /run/ovl/l /run/ovl/u /run/ovl/w /run/ovl/m
  if mount -t overlay overlay -o lowerdir=/run/ovl/l,upperdir=/run/ovl/u,workdir=/run/ovl/w /run/ovl/m 2>/dev/null; then
    umount /run/ovl/m; say "overlay mounts"
  else
    say "overlay module loaded but mount FAILED"
  fi
else
  say "no overlay.ko: builds will write one flat layer"
fi

# A container runtime needs these to exist inside the container's own view.
mkdir -p /var/lib/mengd /usr/local/bin /tmp /run
cp /opt/mrun /usr/local/bin/mrun && chmod 755 /usr/local/bin/mrun
cp /opt/mfwd /usr/local/bin/mfwd && chmod 755 /usr/local/bin/mfwd
chmod 1777 /tmp

# Loopback. Nothing else brings it up in here -- the runtime raises it inside a
# container's own namespace, and this machine's own is a different interface.
# Without it 127.0.0.1 is unreachable, which is where everything in this guest
# talks to everything else in it.
ip link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up 2>/dev/null
say "loopback is $(ip -o link show lo 2>/dev/null | grep -o 'state [A-Z]*' || echo 'unknown')"

# The daemon's own output goes to a file, and a tail carries it to the console.
# HOW IT ENDS is reported separately, because that is the one line that never
# appears in its output: a signal has no last words, and 139 and 134 and 1 are
# three different faults wearing the same silence.
mkdir -p /var/log
: > /var/log/mengd.log
# Straight to the serial console, not through /dev/kmsg. The kernel rate-limits
# what userspace writes to kmsg, and what it drops is whatever a busy daemon
# said last -- which is the only part worth having when it stops.
CON=/dev/ttyAMA0
[ -c "$CON" ] || CON=/dev/kmsg
( # Outward routes. MVM_FWD_OUT is "<vsock port>:<local port>[,...]" on the
# kernel command line. Something in here with no network -- the daemon pulling
# from a registry, say -- connects to that local port and the forwarder carries
# it out on vsock, where the VMM decides what it reaches.
if [ -n "${MVM_FWD_OUT:-}" ]; then
  echo "$MVM_FWD_OUT" | tr ',' ' ' | tr ' ' '\n' | while read -r m; do
    [ -n "$m" ] || continue
    v=${m%%:*}; l=${m##*:}
    ( /usr/local/bin/mfwd out "$v" "$l" 2>&1 | while read -r x; do echo "mfwd: $x" > "$CON"; done ) &
  done
  say "outward forwarders started for $MVM_FWD_OUT"
fi

# A certificate authority to trust, and any registry this machine may speak to
# in the clear. Both come off the kernel command line, because both are the
# caller's facts: which registry, and whether it is one this machine has a
# certificate for.
[ -r /opt/ca.pem ] && export MENGD_CA=/opt/ca.pem
[ -n "${MENGD_INSECURE:-}" ] && export MENGD_INSECURE
# A proxy to reach anything this machine cannot name in advance. There is no
# route out of here at all, so a registry that redirects to a content network
# is unreachable without one.
[ -n "${MENGD_PROXY:-}" ] && export MENGD_PROXY

MENGD_TRACE=1 /opt/mengd vsock://1024 /var/lib/mengd /usr/local/bin/mrun \
    >> /var/log/mengd.log 2>&1
  echo "mengd EXITED with status $?" >> /var/log/mengd.log ) &
( tail -f /var/log/mengd.log | while read -r l; do echo "mengd: $l" > "$CON"; done ) &
# The log has to reach the DISK, not just the page cache: this machine is
# stopped by being killed, and an unflushed file is one the host cannot read
# back. That is why the first three attempts at reading it found nothing.
( while true; do sync; sleep 2; done ) &
say "mengd started on vsock port 1024"


i=0
while [ "$i" -lt "${MENGD_SECONDS:-180}" ]; do sleep 1; i=$((i+1)); done
say "init-mengd-disk done"
sync
poweroff -f
exit 99
